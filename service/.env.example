# Copy to .env. The real .env is gitignored.
PORT=8080
APP_ENV=local

DB_HOST=localhost
DB_PORT=5432
DB_NAME=hedge
DB_USER=hedge
DB_PASSWORD=hedge
DB_SCHEMA=public
DB_SSLMODE=disable

# Where the oracle answers.
ORACLE_URL=http://localhost:8081

# The service's own key, 32 bytes of hex: the third of the 2-of-3 a unilateral
# exit sweeps into. This one is a demo key and is in git on purpose.
#
# It must survive restarts. It is baked into every pre-signed exit, and losing
# it leaves those exits with two usable signatures out of three.
SERVICE_SEED=2626262626262626262626262626262626262626262626262626262626262626

# The faucet, which only exists on regtest. Relative to service/.
REGTEST_SCRIPT=../scripts/regtest.sh

# --- Oracle -------------------------------------------------------------
#
# The oracle is its own binary (`just oracle`) and shares only the database.

ORACLE_PORT=8081

# How far apart two publications are. The covenant settles on a message and the
# one immediately before it, so this is also the gap between those two.
ORACLE_INTERVAL_SECONDS=5

# The signing key, 32 bytes of hex. This one is a demo key and is in git on
# purpose — do not use it anywhere real.
#
# It has to stay the same across restarts: the public half is baked into every
# contract's taproot address, so changing it orphans every live contract.
ORACLE_SEED=1111111111111111111111111111111111111111111111111111111111111111

# The opening price, in cents per BTC. 10000000 is $100,000.
ORACLE_START_PRICE=10000000

# Lets a client set the price over HTTP. That is the demo's price lever; a real
# feed reads a market and exposes no such thing.
ORACLE_ALLOW_MANUAL=true
